{
  "name": "shuzu",
  "version": "0.1.0",
  "private": true,
  "description": "SHUZU — быстрый VPN-клиент с встроенным ядром",
  "author": "SHUZU",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"npm:electron:build && wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "electron:build": "node scripts/build-electron.mjs",
    "start": "npm run electron:build && electron .",
    "map": "node scripts/build-map.mjs",
    "icon": "node scripts/build-icons.mjs",
    "test": "node scripts/test.mjs",
    "dist:win": "npm run build && npm run electron:build && electron-builder --win --config electron-builder.yml",
    "check:config": "node scripts/check-config.mjs",
    "smoke": "node scripts/smoke.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "cores": "bash scripts/fetch-cores.sh",
    "check:java": "node scripts/check-java.mjs",
    "verify": "npm run typecheck && npm test && npm run check:java && npm run smoke && npm run check:config"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "java-parser": "^3.0.1",
    "jsdom": "^25.0.1",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "d3-geo": "^3.1.2",
    "flag-icons": "^7.6.0",
    "framer-motion": "^11.18.2",
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  }
}
